<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Pilates">
<meta name="theme-color" content="#2c2c2c">
<meta name="description" content="4-Month Pilates Instructor Curriculum based on Pilates Anatomy by Isacowitz & Clippinger">
<title>Pilates Instructor Curriculum — 4-Month Program</title>
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="icon-192.png">
<link rel="icon" type="image/png" sizes="192x192" href="icon-192.png">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root {
  --sand: #f5efe6;
  --clay: #c4a882;
  --terracotta: #b5643a;
  --sage: #7a8c72;
  --charcoal: #2c2c2c;
  --warm-white: #faf8f4;
  --light-clay: #ede3d6;
}

- { margin: 0; padding: 0; box-sizing: border-box; }

body {
font-family: ‘DM Sans’, sans-serif;
background: var(–warm-white);
color: var(–charcoal);
font-size: 15px;
line-height: 1.7;
}

/* ── TOOLBAR ── */
.toolbar {
position: sticky;
top: 0;
z-index: 100;
background: var(–charcoal);
padding: 10px 60px;
display: flex;
align-items: center;
justify-content: space-between;
border-bottom: 1px solid rgba(196,168,130,0.2);
gap: 16px;
flex-wrap: wrap;
}

.toolbar-left {
display: flex;
align-items: center;
gap: 12px;
}

.toolbar-brand {
font-family: ‘Cormorant Garamond’, serif;
font-size: 18px;
font-weight: 300;
color: var(–clay);
letter-spacing: 1px;
}

.toolbar-right {
display: flex;
align-items: center;
gap: 10px;
flex-wrap: wrap;
}

.progress-bar-wrap {
display: flex;
align-items: center;
gap: 8px;
}

.progress-label {
font-size: 11px;
letter-spacing: 1.5px;
text-transform: uppercase;
color: rgba(245,239,230,0.5);
white-space: nowrap;
}

.progress-track {
width: 120px;
height: 4px;
background: rgba(196,168,130,0.2);
border-radius: 2px;
overflow: hidden;
}

.progress-fill {
height: 100%;
background: var(–clay);
border-radius: 2px;
transition: width 0.4s ease;
}

.progress-pct {
font-size: 12px;
color: var(–clay);
min-width: 32px;
}

/* Language Selector */
.lang-selector {
position: relative;
}

.lang-btn {
background: rgba(196,168,130,0.15);
border: 1px solid rgba(196,168,130,0.3);
color: var(–clay);
padding: 6px 14px;
font-family: ‘DM Sans’, sans-serif;
font-size: 12px;
letter-spacing: 1px;
cursor: pointer;
border-radius: 2px;
display: flex;
align-items: center;
gap: 6px;
transition: background 0.2s;
}

.lang-btn:hover { background: rgba(196,168,130,0.25); }

.lang-dropdown {
position: absolute;
top: calc(100% + 6px);
right: 0;
background: var(–charcoal);
border: 1px solid rgba(196,168,130,0.25);
border-radius: 2px;
min-width: 180px;
max-height: 420px;
overflow-y: auto;
display: none;
z-index: 200;
}

.lang-dropdown.open { display: block; }

.lang-option {
padding: 10px 16px;
font-size: 13px;
color: rgba(245,239,230,0.7);
cursor: pointer;
transition: background 0.15s, color 0.15s;
display: flex;
align-items: center;
gap: 8px;
}

.lang-option:hover { background: rgba(196,168,130,0.15); color: var(–clay); }
.lang-option.active { color: var(–clay); background: rgba(196,168,130,0.1); }

.lang-flag { font-size: 16px; }

/* Translation loading */
.translating-banner {
position: fixed;
bottom: 20px;
left: 50%;
transform: translateX(-50%);
background: var(–charcoal);
color: var(–clay);
padding: 10px 24px;
border-radius: 2px;
font-size: 13px;
letter-spacing: 1px;
border: 1px solid rgba(196,168,130,0.3);
z-index: 999;
display: none;
align-items: center;
gap: 8px;
}

.translating-banner.show { display: flex; }

.spinner {
width: 14px; height: 14px;
border: 2px solid rgba(196,168,130,0.3);
border-top-color: var(–clay);
border-radius: 50%;
animation: spin 0.7s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* ── HERO ── */
.hero {
background: var(–charcoal);
color: var(–sand);
padding: 80px 60px 60px;
position: relative;
overflow: hidden;
}

.hero::before {
content: ‘’;
position: absolute;
top: -80px; right: -80px;
width: 400px; height: 400px;
border-radius: 50%;
background: radial-gradient(circle, rgba(196,168,130,0.15) 0%, transparent 70%);
}

.hero::after {
content: ‘PILATES’;
position: absolute;
bottom: -30px; right: 40px;
font-family: ‘Cormorant Garamond’, serif;
font-size: 160px;
font-weight: 300;
color: rgba(255,255,255,0.04);
letter-spacing: 10px;
pointer-events: none;
user-select: none;
}

.hero-tag {
font-size: 11px;
letter-spacing: 3px;
text-transform: uppercase;
color: var(–clay);
margin-bottom: 20px;
}

.hero h1 {
font-family: ‘Cormorant Garamond’, serif;
font-size: 58px;
font-weight: 300;
line-height: 1.1;
margin-bottom: 16px;
}

.hero h1 em { font-style: italic; color: var(–clay); }

.hero p {
max-width: 520px;
color: rgba(245,239,230,0.7);
font-size: 15px;
font-weight: 300;
margin-bottom: 40px;
}

.hero-meta {
display: flex;
gap: 40px;
flex-wrap: wrap;
margin-bottom: 30px;
}

.hero-stat { display: flex; flex-direction: column; }

.hero-stat span:first-child {
font-family: ‘Cormorant Garamond’, serif;
font-size: 36px;
font-weight: 300;
color: var(–clay);
line-height: 1;
}

.hero-stat span:last-child {
font-size: 11px;
letter-spacing: 2px;
text-transform: uppercase;
color: rgba(245,239,230,0.5);
margin-top: 4px;
}

/* ── ADD VIDEO HERO BUTTON ── */
.hero-video-btn {
display: inline-flex;
align-items: center;
gap: 8px;
background: rgba(196,168,130,0.15);
border: 1px solid rgba(196,168,130,0.4);
color: var(–clay);
padding: 10px 20px;
font-family: ‘DM Sans’, sans-serif;
font-size: 12px;
letter-spacing: 1.5px;
text-transform: uppercase;
cursor: pointer;
border-radius: 2px;
transition: background 0.2s;
}

.hero-video-btn:hover { background: rgba(196,168,130,0.25); }

/* ── OVERVIEW ── */
.overview {
background: var(–light-clay);
padding: 50px 60px;
display: grid;
grid-template-columns: 1fr 1fr 1fr 1fr;
gap: 30px;
}

.overview-card {
padding: 24px;
background: var(–warm-white);
border-radius: 2px;
border-left: 3px solid var(–terracotta);
}

.overview-card h3 {
font-size: 11px;
letter-spacing: 2px;
text-transform: uppercase;
color: var(–terracotta);
margin-bottom: 10px;
}

.overview-card p {
font-size: 14px;
color: var(–charcoal);
font-weight: 300;
}

/* ── SECTION HEADING ── */
.section-header {
padding: 60px 60px 20px;
}

.section-header .eyebrow {
font-size: 11px;
letter-spacing: 3px;
text-transform: uppercase;
color: var(–sage);
margin-bottom: 10px;
}

.section-header h2 {
font-family: ‘Cormorant Garamond’, serif;
font-size: 40px;
font-weight: 300;
line-height: 1.2;
}

/* ── MONTH GRID ── */
.months-container {
padding: 10px 60px 60px;
display: grid;
grid-template-columns: 1fr 1fr;
gap: 30px;
}

.month-card {
background: var(–warm-white);
border: 1px solid var(–light-clay);
border-radius: 2px;
overflow: hidden;
animation: fadeUp 0.6s ease both;
}

.month-card:nth-child(1) { animation-delay: 0.1s; }
.month-card:nth-child(2) { animation-delay: 0.2s; }
.month-card:nth-child(3) { animation-delay: 0.3s; }
.month-card:nth-child(4) { animation-delay: 0.4s; }

@keyframes fadeUp {
from { opacity: 0; transform: translateY(20px); }
to { opacity: 1; transform: translateY(0); }
}

.month-header {
padding: 24px 28px;
display: flex;
align-items: center;
gap: 20px;
border-bottom: 1px solid var(–light-clay);
cursor: pointer;
user-select: none;
transition: background 0.2s;
}

.month-header:hover { background: rgba(237,227,214,0.4); }

.month-number {
font-family: ‘Cormorant Garamond’, serif;
font-size: 52px;
font-weight: 300;
line-height: 1;
color: var(–clay);
min-width: 50px;
}

.month-title-block h3 {
font-family: ‘Cormorant Garamond’, serif;
font-size: 22px;
font-weight: 400;
margin-bottom: 3px;
}

.month-title-block .subtitle {
font-size: 12px;
color: var(–clay);
letter-spacing: 1.5px;
text-transform: uppercase;
font-weight: 400;
}

.month-toggle {
margin-left: auto;
color: var(–clay);
font-size: 20px;
transition: transform 0.3s;
flex-shrink: 0;
}

.month-card.collapsed .month-toggle { transform: rotate(-90deg); }

.month-body {
padding: 24px 28px;
transition: max-height 0.4s ease, opacity 0.3s ease;
overflow: hidden;
}

.month-card.collapsed .month-body {
max-height: 0 !important;
opacity: 0;
padding-top: 0;
padding-bottom: 0;
}

/* ── WEEK BLOCKS ── */
.week-block { margin-bottom: 20px; }
.week-block:last-child { margin-bottom: 0; }

.week-label {
font-size: 10px;
letter-spacing: 2px;
text-transform: uppercase;
color: var(–terracotta);
margin-bottom: 8px;
font-weight: 500;
}

.week-content {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 8px;
}

.task {
background: var(–sand);
padding: 10px 12px;
border-radius: 2px;
font-size: 13px;
position: relative;
}

.task strong {
display: block;
font-size: 11px;
font-weight: 500;
color: var(–terracotta);
letter-spacing: 0.5px;
margin-bottom: 3px;
text-transform: uppercase;
}

.task p {
font-weight: 300;
color: var(–charcoal);
font-size: 12.5px;
line-height: 1.5;
}

.chapter-ref {
display: inline-block;
font-size: 10px;
background: var(–clay);
color: white;
padding: 1px 6px;
border-radius: 10px;
margin-top: 4px;
font-weight: 400;
}

/* ── COMPLETION CHECKBOX ── */
.task-check {
position: absolute;
top: 8px;
right: 8px;
width: 18px;
height: 18px;
border: 1.5px solid var(–clay);
border-radius: 2px;
cursor: pointer;
display: flex;
align-items: center;
justify-content: center;
transition: background 0.2s, border-color 0.2s;
flex-shrink: 0;
}

.task-check.done {
background: var(–sage);
border-color: var(–sage);
}

.task-check.done::after {
content: ‘✓’;
color: white;
font-size: 11px;
line-height: 1;
}

.task.done-task {
opacity: 0.55;
}

.task.done-task p {
text-decoration: line-through;
text-decoration-color: var(–clay);
}

/* ── VIDEO SECTION per week ── */
.video-slot {
margin-top: 8px;
border: 1.5px dashed rgba(196,168,130,0.45);
border-radius: 2px;
background: rgba(245,239,230,0.5);
overflow: hidden;
}

.add-video-btn {
width: 100%;
padding: 10px 14px;
background: transparent;
border: none;
cursor: pointer;
font-family: ‘DM Sans’, sans-serif;
font-size: 11px;
letter-spacing: 2px;
text-transform: uppercase;
color: var(–clay);
display: flex;
align-items: center;
gap: 6px;
transition: background 0.2s;
}

.add-video-btn:hover { background: rgba(196,168,130,0.1); }

.add-video-btn .icon {
width: 20px; height: 20px;
border: 1.5px solid var(–clay);
border-radius: 50%;
display: flex;
align-items: center;
justify-content: center;
font-size: 12px;
flex-shrink: 0;
}

.video-input-wrap {
padding: 10px 14px;
display: none;
gap: 8px;
flex-direction: column;
}

.video-input-wrap.open { display: flex; }

.video-input-wrap input {
width: 100%;
padding: 8px 10px;
background: var(–warm-white);
border: 1px solid rgba(196,168,130,0.4);
border-radius: 2px;
font-family: ‘DM Sans’, sans-serif;
font-size: 12px;
color: var(–charcoal);
outline: none;
}

.video-input-wrap input:focus {
border-color: var(–clay);
}

.video-input-wrap input::placeholder { color: rgba(44,44,44,0.4); }

.video-actions {
display: flex;
gap: 6px;
}

.vid-confirm, .vid-cancel {
padding: 6px 12px;
font-family: ‘DM Sans’, sans-serif;
font-size: 11px;
letter-spacing: 1px;
text-transform: uppercase;
border: none;
cursor: pointer;
border-radius: 2px;
}

.vid-confirm {
background: var(–clay);
color: white;
}

.vid-confirm:hover { background: var(–terracotta); }

.vid-cancel {
background: transparent;
border: 1px solid rgba(196,168,130,0.4);
color: var(–clay);
}

.vid-cancel:hover { background: rgba(196,168,130,0.1); }

/* Embedded video */
.video-embed-wrap {
position: relative;
width: 100%;
padding-bottom: 56.25%;
background: #000;
}

.video-embed-wrap iframe {
position: absolute;
inset: 0;
width: 100%;
height: 100%;
border: none;
}

.video-label-bar {
padding: 6px 14px;
display: flex;
align-items: center;
justify-content: space-between;
background: rgba(196,168,130,0.1);
}

.video-label-bar span {
font-size: 11px;
color: var(–clay);
letter-spacing: 1px;
}

.video-remove-btn {
background: transparent;
border: none;
cursor: pointer;
color: rgba(181,100,58,0.5);
font-size: 13px;
padding: 2px 4px;
transition: color 0.2s;
}

.video-remove-btn:hover { color: var(–terracotta); }

/* ── ANATOMY SECTION ── */
.anatomy-section {
background: var(–charcoal);
color: var(–sand);
padding: 60px;
}

.anatomy-section .eyebrow {
font-size: 11px;
letter-spacing: 3px;
text-transform: uppercase;
color: var(–clay);
margin-bottom: 10px;
}

.anatomy-section h2 {
font-family: ‘Cormorant Garamond’, serif;
font-size: 36px;
font-weight: 300;
margin-bottom: 30px;
}

.anatomy-grid {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 20px;
}

.anatomy-item {
padding: 20px;
border: 1px solid rgba(196,168,130,0.25);
border-radius: 2px;
}

.anatomy-item h4 {
font-family: ‘Cormorant Garamond’, serif;
font-size: 18px;
font-weight: 400;
color: var(–clay);
margin-bottom: 8px;
}

.anatomy-item p {
font-size: 13px;
font-weight: 300;
color: rgba(245,239,230,0.65);
line-height: 1.6;
}

/* ── SCHEDULE SECTION ── */
.schedule-section {
padding: 60px;
background: var(–sand);
}

.schedule-section .eyebrow {
font-size: 11px;
letter-spacing: 3px;
text-transform: uppercase;
color: var(–sage);
margin-bottom: 10px;
}

.schedule-section h2 {
font-family: ‘Cormorant Garamond’, serif;
font-size: 36px;
font-weight: 300;
margin-bottom: 30px;
}

.schedule-table {
width: 100%;
border-collapse: collapse;
font-size: 13.5px;
}

.schedule-table th {
text-align: left;
font-size: 10px;
letter-spacing: 2px;
text-transform: uppercase;
color: var(–terracotta);
padding: 10px 16px;
border-bottom: 2px solid var(–clay);
font-weight: 500;
}

.schedule-table td {
padding: 12px 16px;
border-bottom: 1px solid rgba(196,168,130,0.3);
vertical-align: top;
font-weight: 300;
line-height: 1.5;
}

.schedule-table tr:last-child td { border-bottom: none; }

.day-label {
font-weight: 500;
color: var(–terracotta);
white-space: nowrap;
font-size: 13px;
letter-spacing: 0.5px;
}

.rest-day { color: var(–sage); font-style: italic; }

/* ── PROGRESSION ── */
.progression-section { padding: 60px; }

.progression-section .eyebrow {
font-size: 11px;
letter-spacing: 3px;
text-transform: uppercase;
color: var(–sage);
margin-bottom: 10px;
}

.progression-section h2 {
font-family: ‘Cormorant Garamond’, serif;
font-size: 36px;
font-weight: 300;
margin-bottom: 30px;
}

.progression-track {
display: grid;
grid-template-columns: 1fr 1fr 1fr;
gap: 24px;
margin-bottom: 30px;
}

.prog-level { border-radius: 2px; overflow: hidden; }

.prog-level-header {
padding: 16px 20px;
font-size: 11px;
letter-spacing: 2px;
text-transform: uppercase;
font-weight: 500;
}

.prog-level-header.fundamental { background: var(–sage); color: white; }
.prog-level-header.intermediate { background: var(–clay); color: white; }
.prog-level-header.advanced { background: var(–terracotta); color: white; }

.prog-level-body {
background: var(–light-clay);
padding: 16px 20px;
}

.exercise-list {
list-style: none;
font-size: 13px;
font-weight: 300;
line-height: 2;
}

.exercise-list li::before {
content: ‘—’;
color: var(–clay);
margin-right: 8px;
}

/* ── ASSESSMENT ── */
.assessment-section {
background: var(–light-clay);
padding: 60px;
}

.assessment-section .eyebrow {
font-size: 11px;
letter-spacing: 3px;
text-transform: uppercase;
color: var(–terracotta);
margin-bottom: 10px;
}

.assessment-section h2 {
font-family: ‘Cormorant Garamond’, serif;
font-size: 36px;
font-weight: 300;
margin-bottom: 30px;
}

.assessment-grid {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 24px;
}

.assessment-card {
background: var(–warm-white);
padding: 24px;
border-radius: 2px;
border-top: 3px solid var(–clay);
}

.assessment-card h4 {
font-size: 13px;
letter-spacing: 1px;
text-transform: uppercase;
color: var(–terracotta);
margin-bottom: 12px;
font-weight: 500;
}

.assessment-card ul {
list-style: none;
font-size: 13.5px;
font-weight: 300;
line-height: 1.9;
}

.assessment-card ul li::before {
content: ’✓ ’;
color: var(–sage);
font-weight: 500;
}

/* ── RESOURCES ── */
.resources-section {
padding: 60px;
background: var(–warm-white);
}

.resources-section .eyebrow {
font-size: 11px;
letter-spacing: 3px;
text-transform: uppercase;
color: var(–sage);
margin-bottom: 10px;
}

.resources-section h2 {
font-family: ‘Cormorant Garamond’, serif;
font-size: 36px;
font-weight: 300;
margin-bottom: 30px;
}

.resources-grid {
display: grid;
grid-template-columns: 1fr 1fr 1fr;
gap: 20px;
}

.resource-card {
padding: 20px;
background: var(–sand);
border-radius: 2px;
font-size: 13.5px;
}

.resource-card h4 {
font-family: ‘Cormorant Garamond’, serif;
font-size: 18px;
font-weight: 400;
color: var(–terracotta);
margin-bottom: 8px;
}

.resource-card p {
font-weight: 300;
color: var(–charcoal);
line-height: 1.6;
}

/* ── FOOTER ── */
.footer {
background: var(–charcoal);
color: rgba(245,239,230,0.4);
padding: 30px 60px;
text-align: center;
font-size: 12px;
font-weight: 300;
letter-spacing: 1px;
}

.footer span { color: var(–clay); }

/* ── VIDEO MODAL ── */
.modal-overlay {
position: fixed;
inset: 0;
background: rgba(0,0,0,0.75);
z-index: 500;
display: none;
align-items: center;
justify-content: center;
padding: 20px;
backdrop-filter: blur(4px);
}

.modal-overlay.open { display: flex; }

.modal {
background: var(–charcoal);
border: 1px solid rgba(196,168,130,0.25);
border-radius: 2px;
padding: 36px;
width: 100%;
max-width: 520px;
position: relative;
animation: modalIn 0.25s ease;
}

@keyframes modalIn {
from { opacity: 0; transform: scale(0.96) translateY(10px); }
to { opacity: 1; transform: scale(1) translateY(0); }
}

.modal-close {
position: absolute;
top: 14px; right: 16px;
background: transparent;
border: none;
color: rgba(196,168,130,0.5);
font-size: 20px;
cursor: pointer;
transition: color 0.2s;
}

.modal-close:hover { color: var(–clay); }

.modal h3 {
font-family: ‘Cormorant Garamond’, serif;
font-size: 24px;
font-weight: 300;
color: var(–sand);
margin-bottom: 6px;
}

.modal .modal-sub {
font-size: 11px;
letter-spacing: 2px;
text-transform: uppercase;
color: var(–clay);
margin-bottom: 24px;
}

.modal label {
display: block;
font-size: 11px;
letter-spacing: 1.5px;
text-transform: uppercase;
color: rgba(245,239,230,0.5);
margin-bottom: 6px;
}

.modal input, .modal textarea {
