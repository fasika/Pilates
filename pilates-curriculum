<!-- VIDEO MODAL -->

<div class="modal-overlay" id="videoModal">
  <div class="modal">
    <button class="modal-close" onclick="closeModal()">✕</button>
    <h3 data-i18n="add-video-modal-title">Add Video</h3>
    <p class="modal-sub" id="modalSubtitle">Week 1 — The Six Principles</p>
    <label data-i18n="modal-url-label">YouTube or Vimeo URL</label>
    <input type="text" id="videoUrlInput" placeholder="https://www.youtube.com/watch?v=...">
    <label data-i18n="modal-title-label">Video Title (optional)</label>
    <input type="text" id="videoTitleInput" placeholder="e.g. Breath Technique Tutorial">
    <div class="modal-actions">
      <button class="modal-save" onclick="saveVideo()" data-i18n="embed-video">Embed Video</button>
      <button class="modal-cancel" onclick="closeModal()" data-i18n="cancel">Cancel</button>
    </div>
  </div>
</div>

<script>
// ── STATE ──
let currentVideoSlot = null;
let videos = {};
let completedTasks = new Set();
let currentLang = 'en';

const TOTAL_TASKS = 32; // 2 tasks × 16 weeks

// ── TRANSLATIONS via Claude API ──
const translationCache = { en: {} };

const uiStrings = {
  en: {
    'translating': 'Translating curriculum…',
    'add-video-banner': 'Add Video for this Week',
  }
};

async function translatePage(lang) {
  if (lang === 'en') {
    restoreEnglish();
    return;
  }

  if (translationCache[lang]) {
    applyTranslations(translationCache[lang]);
    return;
  }

  showTranslatingBanner(true);

  // Collect all translatable text
  const elements = document.querySelectorAll('[data-i18n]');
  const texts = {};
  elements.forEach(el => {
    const key = el.getAttribute('data-i18n');
    texts[key] = el.innerText.trim();
  });

  // Store originals once
  if (!translationCache.en || Object.keys(translationCache.en).length === 0) {
    translationCache.en = { ...texts };
  }

  const langNames = {
    es: 'Spanish', fr: 'French', de: 'German', pt: 'Portuguese (Brazilian)',
    it: 'Italian', ja: 'Japanese', zh: 'Simplified Chinese', ko: 'Korean', ar: 'Arabic',
    sw: 'Swahili (Kiswahili)', am: 'Amharic', ha: 'Hausa', yo: 'Yoruba',
    ig: 'Igbo', zu: 'Zulu (isiZulu)', xh: 'Xhosa (isiXhosa)', so: 'Somali',
    rw: 'Kinyarwanda', lg: 'Luganda', sn: 'Shona', st: 'Sesotho',
    tw: 'Twi (Akan)', wo: 'Wolof', om: 'Oromo (Afaan Oromoo)'
  };

  const langName = langNames[lang] || lang;

  try {
    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 4000,
        system: `You are a professional translator specializing in fitness, anatomy, and Pilates instruction. 
Translate the provided JSON object's values from English to ${langName}. 
Keep exercise names in their original English form (e.g., "Pelvic Curl", "Hundred", "Teaser", "Swan Dive") as these are established Pilates terminology.
Keep book chapter references (e.g., "Ch 1 · pp. 1–10") unchanged.
Keep author names and book titles unchanged.
Return ONLY a valid JSON object with the same keys and translated values. No markdown, no explanation.`,
        messages: [{
          role: 'user',
          content: `Translate these curriculum texts to ${langName}:\n${JSON.stringify(texts, null, 2)}`
        }]
      })
    });

    const data = await response.json();
    const raw = data.content.map(b => b.text || '').join('');
    const clean = raw.replace(/```json|```/g, '').trim();
    const translated = JSON.parse(clean);
    translationCache[lang] = translated;
    applyTranslations(translated);
  } catch (e) {
    console.error('Translation failed:', e);
  }

  showTranslatingBanner(false);
}

function applyTranslations(dict) {
  const elements = document.querySelectorAll('[data-i18n]');
  elements.forEach(el => {
    const key = el.getAttribute('data-i18n');
    if (dict[key]) {
      // Preserve HTML tags inside (like <em> and <br>)
      if (el.innerHTML.includes('<') && !el.innerHTML.includes('<span')) {
        // For headings with em/br, update text nodes only
        el.innerHTML = el.innerHTML.replace(
          /^([^<]*)(<.*>)([^<]*)$/,
          () => dict[key]
        );
      } else {
        el.innerText = dict[key];
      }
    }
  });
}

function restoreEnglish() {
  if (!translationCache.en || Object.keys(translationCache.en).length === 0) return;
  applyTranslations(translationCache.en);
}

function showTranslatingBanner(show) {
  const b = document.getElementById('translatingBanner');
  if (show) b.classList.add('show');
  else setTimeout(() => b.classList.remove('show'), 400);
}

// ── LANGUAGE MENU ──
function toggleLangMenu() {
  document.getElementById('langDropdown').classList.toggle('open');
}

document.addEventListener('click', e => {
  if (!e.target.closest('.lang-selector')) {
    document.getElementById('langDropdown').classList.remove('open');
  }
});

function setLang(code, label, flag) {
  currentLang = code;
  document.getElementById('currentLang').textContent = label;
  document.getElementById('currentFlag').textContent = flag;
  document.getElementById('langDropdown').classList.remove('open');

  // Update active state
  document.querySelectorAll('.lang-option').forEach(o => o.classList.remove('active'));
  event.target.closest('.lang-option').classList.add('active');

  translatePage(code);
}

// ── MONTH COLLAPSE ──
function toggleMonth(id) {
  const card = document.getElementById(id);
  const body = card.querySelector('.month-body');
  const isCollapsed = card.classList.contains('collapsed');

  if (isCollapsed) {
    card.classList.remove('collapsed');
    body.style.maxHeight = body.scrollHeight + 'px';
    setTimeout(() => body.style.maxHeight = 'none', 400);
  } else {
    body.style.maxHeight = body.scrollHeight + 'px';
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        card.classList.add('collapsed');
      });
    });
  }
}

// Initialize month bodies
document.querySelectorAll('.month-body').forEach(b => b.style.maxHeight = 'none');

// ── TASK COMPLETION ──
function toggleTask(taskId) {
  const task = document.getElementById(taskId);
  const check = task.querySelector('.task-check');

  if (completedTasks.has(taskId)) {
    completedTasks.delete(taskId);
    check.classList.remove('done');
    task.classList.remove('done-task');
  } else {
    completedTasks.add(taskId);
    check.classList.add('done');
    task.classList.add('done-task');
  }

  saveState();
  updateProgress();
}

function updateProgress() {
  const pct = Math.round((completedTasks.size / TOTAL_TASKS) * 100);
  document.getElementById('progressFill').style.width = pct + '%';
  document.getElementById('progressPct').textContent = pct + '%';
}

// ── VIDEO MODAL ──
function openModal(slot, subtitle) {
  currentVideoSlot = slot;
  document.getElementById('modalSubtitle').textContent = subtitle;
  document.getElementById('videoUrlInput').value = '';
  document.getElementById('videoTitleInput').value = '';
  document.getElementById('videoModal').classList.add('open');
  setTimeout(() => document.getElementById('videoUrlInput').focus(), 100);
}

function closeModal() {
  document.getElementById('videoModal').classList.remove('open');
  currentVideoSlot = null;
}

document.getElementById('videoModal').addEventListener('click', e => {
  if (e.target === document.getElementById('videoModal')) closeModal();
});

function saveVideo() {
  const url = document.getElementById('videoUrlInput').value.trim();
  const title = document.getElementById('videoTitleInput').value.trim() || 'Video';
  if (!url) return;

  const embedId = extractVideoId(url);
  if (!embedId) {
    alert('Please enter a valid YouTube or Vimeo URL.');
    return;
  }

  videos[currentVideoSlot] = { url, embedId: embedId.id, type: embedId.type, title };
  renderVideo(currentVideoSlot);
  saveState();
  closeModal();
}

function extractVideoId(url) {
  // YouTube
  let m = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]{11})/);
  if (m) return { id: m[1], type: 'youtube' };
  // Vimeo
  m = url.match(/vimeo\.com\/(\d+)/);
  if (m) return { id: m[1], type: 'vimeo' };
  return null;
}

function renderVideo(slot) {
  const v = videos[slot];
  if (!v) return;
  const container = document.getElementById(slot + '-video-container');
  if (!container) return;

  const src = v.type === 'youtube'
    ? `https://www.youtube.com/embed/${v.embedId}?rel=0&modestbranding=1`
    : `https://player.vimeo.com/video/${v.embedId}`;

  container.innerHTML = `
    <div class="video-label-bar">
      <span>▶ ${v.title}</span>
      <button class="video-remove-btn" onclick="removeVideo('${slot}')" title="Remove video">✕</button>
    </div>
    <div class="video-embed-wrap">
      <iframe src="${src}" allowfullscreen loading="lazy"></iframe>
    </div>
  `;

  // Hide add button, show embedded
  const slot_el = container.closest('.video-slot');
  if (slot_el) {
    const btn = slot_el.querySelector('.add-video-btn');
    if (btn) btn.style.display = 'none';
  }
}

function removeVideo(slot) {
  delete videos[slot];
  const container = document.getElementById(slot + '-video-container');
  if (container) container.innerHTML = '';
  const slotEl = container ? container.closest('.video-slot') : null;
  if (slotEl) {
    const btn = slotEl.querySelector('.add-video-btn');
    if (btn) btn.style.display = '';
  }
  saveState();
}

// ── NOTES ──
function saveNotes() {
  const notes = document.getElementById('personalNotes').value;
  localStorage.setItem('pilates-notes', notes);
  const msg = document.getElementById('notesSavedMsg');
  msg.classList.add('show');
  setTimeout(() => msg.classList.remove('show'), 2000);
}

// ── PERSIST STATE (localStorage) ──
function saveState() {
  localStorage.setItem('pilates-videos', JSON.stringify(videos));
  localStorage.setItem('pilates-tasks', JSON.stringify([...completedTasks]));
}

function loadState() {
  try {
    const v = localStorage.getItem('pilates-videos');
    if (v) {
      videos = JSON.parse(v);
      Object.keys(videos).forEach(slot => renderVideo(slot));
    }
    const t = localStorage.getItem('pilates-tasks');
    if (t) {
      JSON.parse(t).forEach(id => {
        completedTasks.add(id);
        const task = document.getElementById(id);
        if (task) {
          task.querySelector('.task-check').classList.add('done');
          task.classList.add('done-task');
        }
      });
    }
    const n = localStorage.getItem('pilates-notes');
    if (n) document.getElementById('personalNotes').value = n;
  } catch (e) {}
  updateProgress();
}

// ── KEYBOARD: close modal on Escape ──
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') closeModal();
});

// ── INIT ──
loadState();


// ══════════════════════════════════════
// PWA: Service Worker Registration
// ══════════════════════════════════════
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('./sw.js')
      .then(reg => console.log('SW registered:', reg.scope))
      .catch(err => console.log('SW failed:', err));
  });
}

// ── OFFLINE DETECTION ──
function updateOnlineStatus() {
  const badge = document.getElementById('offlineBadge');
  if (!navigator.onLine) badge.classList.add('show');
  else badge.classList.remove('show');
}
window.addEventListener('online', updateOnlineStatus);
window.addEventListener('offline', updateOnlineStatus);

// ── INSTALL PROMPT ──
let deferredPrompt = null;

window.addEventListener('beforeinstallprompt', e => {
  e.preventDefault();
  deferredPrompt = e;
  // Show banner after 3 seconds if not already installed
  setTimeout(() => {
    if (!window.matchMedia('(display-mode: standalone)').matches) {
      document.getElementById('installBanner').classList.add('show');
    }
  }, 3000);
});

document.getElementById('installBtn').addEventListener('click', async () => {
  if (!deferredPrompt) return;
  deferredPrompt.prompt();
  const { outcome } = await deferredPrompt.userChoice;
  deferredPrompt = null;
  document.getElementById('installBanner').classList.remove('show');
});

function dismissInstall() {
  document.getElementById('installBanner').classList.remove('show');
  // Don't show again this session
  deferredPrompt = null;
}

// Hide install banner if already running as PWA
if (window.matchMedia('(display-mode: standalone)').matches) {
  document.getElementById('installBanner').style.display = 'none';
}

// ── TAB NAVIGATION ──
const tabSections = {
  home: 'section-home',
  curriculum: 'section-curriculum',
  exercises: 'section-exercises',
  anatomy: 'section-anatomy',
  notes: 'section-notes'
};

function switchTab(tab) {
  // Update sections
  Object.entries(tabSections).forEach(([key, sectionId]) => {
    const section = document.getElementById(sectionId);
    if (section) {
      section.classList.toggle('active', key === tab);
    }
  });

  // Update tab buttons
  document.querySelectorAll('.nav-tab').forEach(btn => {
    btn.classList.toggle('active', btn.id === 'tab-' + tab);
  });

  // Scroll to top
  window.scrollTo({ top: 0, behavior: 'smooth' });

  // Save last tab
  try { localStorage.setItem('pilates-last-tab', tab); } catch(e) {}
}

// Restore last tab on load
(function restoreTab() {
  try {
    const last = localStorage.getItem('pilates-last-tab');
    if (last && tabSections[last]) switchTab(last);
  } catch(e) {}
})();

// On desktop (no bottom nav), show all sections
function checkDesktop() {
  if (window.innerWidth > 600) {
    Object.values(tabSections).forEach(id => {
      const s = document.getElementById(id);
      if (s) s.classList.add('active');
    });
  }
}
checkDesktop();
window.addEventListener('resize', checkDesktop);

</script>

